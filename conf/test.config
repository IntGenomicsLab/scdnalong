/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Public test data only (IntGenomicsLab/test-datasets, lrsinglecell folder):
    a subsampled 10x Multiome ATAC Nanopore library and chr21.

    Use as follows (Nextflow 24.10.x, see README):
        NXF_VER=24.10.4 nextflow run IntGenomicsLab/scdnalong -r dev -profile test,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    // SEQKIT_SPLIT2 declares `array 100`, which only works on grid executors.
    // Disable it so the test also runs with the local executor.
    withName: 'SEQKIT_SPLIT2' {
        array = 0
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal public test dataset to check pipeline function'

    // Input data
    input       = "${projectDir}/assets/samplesheet_test.csv"
    // Subset of the 10x ARC ATAC whitelist (737K-arc-v1) seen in the test reads.
    // flexiplex-filter needs an uncompressed whitelist.
    whitelist   = "${projectDir}/assets/whitelist_test.txt"

    // Genome references
    fasta       = "https://raw.githubusercontent.com/IntGenomicsLab/test-datasets/main/lrsinglecell/reference/chr21.fa"

    // Barcode options
    barcode_format = "10x_atac"

    // The test file has ~140 barcodes, too few for knee detection
    flexiplex_filter_args = "--no-inflection"

    // Splitting options
    split_fastq_n = 2
}
